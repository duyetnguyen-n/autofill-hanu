{
  "manifest_version": 3,
  "name": "HSK Google Forms Autofill",
  "description": "Điền nhanh Google Forms HSK từ một hồ sơ cục bộ với cơ chế tạm dừng an toàn.",
  "version": "1.7.5",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*"
  ],
  "optional_host_permissions": ["https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở HSK Autofill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
