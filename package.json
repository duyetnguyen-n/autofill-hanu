    "test:runner-setup-ui": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/runner-setup-ui-check.ts",
    "test:web-injection-ui": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/web-injection-ui-check.ts",
    "test:runner-launch": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/runner-launch-check.ts",
    "test:hcmue-native": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/hcmue-runner-smoke.ts",
