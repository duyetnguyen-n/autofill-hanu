{
  "name": "hanu-hsk-autofill",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode panel",
    "clean": "node scripts/clean.mjs",
    "build:panel": "vite build --mode panel",
    "build:background": "vite build --mode background",
    "build:content": "vite build --mode content",
    "test": "node scripts/run-node24.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-node24.mjs node_modules/vitest/vitest.mjs",
    "build:extension": "npm run clean && npm run build:panel && npm run build:background && npm run build:content",
    "build:manager": "node scripts/run-node24.mjs scripts/build-manager.mjs",
    "build:manager:assets": "node scripts/run-node24.mjs scripts/build-manager.mjs --skip-native-exe",
    "build": "npm run build:extension && npm run build:manager",
    "build:cloud": "node scripts/run-node24.mjs --env-file=.env.cloud scripts/build-cloud.mjs",
    "build:cloud-extension": "node scripts/run-node24.mjs --env-file=.env.cloud scripts/build-cloud.mjs --extension-only",
    "build:cloud-server": "node scripts/run-node24.mjs scripts/build-cloud-server.mjs",
    "cloud:check": "node scripts/run-node24.mjs --env-file=.env.cloud node_modules/tsx/dist/cli.mjs scripts/check-cloud.ts",
    "cloud:configure-password": "node scripts/run-node24.mjs scripts/configure-cloud-password.mjs",
    "test:access-ui": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/access-ui-check.ts",
    "test:cloud-ui": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/cloud-ui-check.ts",
    "cloud": "node scripts/run-node24.mjs --env-file=.env.cloud build/cloud-server/main.mjs --serve-cloud",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.manager.json",
    "manager": "node scripts/run-node24.mjs build/server/main.mjs --serve",
    "package": "node scripts/run-node24.mjs scripts/package.mjs",
    "test:browser": "node scripts/run-node24.mjs scripts/browser-check.mjs",
    "test:manager-ui": "node scripts/run-node24.mjs scripts/manager-ui-check.mjs",
    "test:final-question-ui": "node scripts/run-node24.mjs scripts/final-question-ui-check.mjs",
    "test:navigation": "node scripts/run-node24.mjs scripts/navigation-check.mjs",
    "test:background-flow": "node scripts/run-node24.mjs scripts/background-flow-check.mjs",
    "test:cloud-flow": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/background-flow-check.mjs --cloud --profiles=3 --final-question",
    "test:cloud-controls": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/background-flow-check.mjs --cloud --profiles=3 --controls",
    "test:cloud-load": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/cloud-load-test.ts",
    "cloud:load-server": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/cloud-load-server.ts",
    "bench:fixture": "node scripts/run-node24.mjs scripts/benchmark.mjs",
    "test:cloud-reliability": "node scripts/run-node24.mjs node_modules/tsx/dist/cli.mjs scripts/background-flow-check.mjs --cloud --profiles=2 --faults"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.313",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  }
}
