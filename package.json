{
  "name": "hanu-hsk-autofill",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode panel",
    "clean": "node scripts/clean.mjs",
    "build:panel": "vite build --mode panel",
    "build:background": "vite build --mode background",
    "build:content": "vite build --mode content",
    "test": "node scripts/run-node24.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-node24.mjs node_modules/vitest/vitest.mjs",
    "build:extension": "npm run clean && npm run build:panel && npm run build:background && npm run build:content",
    "build:manager": "node scripts/run-node24.mjs scripts/build-manager.mjs",
    "build": "npm run build:extension && npm run build:manager",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.manager.json",
    "manager": "node scripts/run-node24.mjs build/server/main.mjs --serve",
    "package": "node scripts/run-node24.mjs scripts/package.mjs",
    "test:browser": "node scripts/run-node24.mjs scripts/browser-check.mjs",
    "bench:fixture": "node scripts/run-node24.mjs scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.313",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  }
}
