# Copy to .env.cloud. Never commit .env.cloud or share its secrets.
PUBLIC_ORIGIN=https://YOUR_DOMAIN
HOST=127.0.0.1
PORT=3000
# Use a NEW dedicated Supabase project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Supabase secret/service_role key: BACKEND ONLY, never extension/UI.
SUPABASE_SECRET_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
# Supabase Connect -> Session pooler (5432); URL-encode the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Download the database CA certificate from Supabase settings if needed.
# PGSSLROOTCERT=secrets/prod-supabase.cer
# Development only: localhost HTTP and local PostgreSQL without TLS.
HANU_CLOUD_DEV=0
# Only enable behind the included Caddy proxy with NO public backend port.
TRUST_PROXY=0
